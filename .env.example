# ==============================================================================
# Real-Time Crypto-Forensics & Fraud-Linked VASP Identification Platform
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
PROJECT_NAME="Crypto-Forensics & Fraud-Linked VASP Identification Platform"
LOG_LEVEL=INFO

# Networking & Ports
SERVER_PORT=8000
CLIENT_PORT=3000
NGINX_PORT=80

# PostgreSQL 16 Relational Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crypto_forensics
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/crypto_forensics
# Local SQLite fallback URL when running server without PostgreSQL container:
# DATABASE_URL=sqlite+aiosqlite:///./crypto_forensics.db

# Neo4j 5.x Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=TestPassword123
NEO4J_DATABASE=neo4j

# Redis 7 (Message Broker & Task Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery Task Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Authentication (RS256 Asymmetric JWT)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=certs/private_key.pem
JWT_PUBLIC_KEY_PATH=certs/public_key.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=antigravity-auth-service

# External Blockchain RPC Providers (Public Mainnet / Testnet / Infura / Alchemy)
ETH_RPC_URL=https://eth.llamarpc.com
BTC_RPC_URL=https://blockstream.info/api
POLYGON_RPC_URL=https://polygon-rpc.com
TRON_RPC_URL=https://api.trongrid.io

# ISO/IEC 27037:2012 Evidence Storage
EVIDENCE_STORAGE_PATH=/data/evidence
S3_STORAGE_BUCKET=crypto-forensics-evidence-vault

# Machine Learning & GNN Settings
GNN_MODEL_PATH=worker_app/ml/weights/graphsage_v1.pth
GNN_HIDDEN_CHANNELS=128
GNN_NUM_LAYERS=3
GNN_OUTPUT_DIM=32

# AI Copilot Live (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
